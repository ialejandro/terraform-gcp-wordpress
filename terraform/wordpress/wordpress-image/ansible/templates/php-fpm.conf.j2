; {{ ansible_managed }}
[{{ servername | regex_replace('(?=\.).*') }}]
user = {{ ws_user }}
group = {{ ws_group }}
listen = /var/run/php/php-fpm.{{ servername | regex_replace('(?=\.).*') }}.sock
listen.owner = {{ ws_user }}
listen.group = {{ ws_group }}
listen.allowed_clients = 127.0.0.1
pm = dynamic
pm.max_children = 10
pm.start_servers = 4
pm.min_spare_servers = 2
pm.max_spare_servers = 4

; PHP values
php_admin_value[memory_limit] = {{ php_memory_limit }}
php_admin_value[max_execution_time] = {{ php_max_execution_time }}
php_admin_value[upload_max_filesize] = {{ php_upload_max_filesize }}
php_admin_value[post_max_size] = {{ php_post_max_size }}

; Log errors
php_admin_value[error_log] = /var/log/php/php-errors.log
php_admin_value[error_reporting] = E_COMPILE_ERROR|E_RECOVERABLE_ERROR|E_ERROR|E_CORE_ERROR
php_admin_flag[log_errors] = on

; Timezone
php_admin_value[date.timezone] = Europe/Madrid

; Environment variables
env[HOSTNAME] = $HOSTNAME
env[PATH] = /usr/local/bin:/usr/bin:/bin
env[TMP] = /tmp
env[TMPDIR] = /tmp
env[TEMP] = /tmp
